# Local CLI config.
# In AWS, API_URL is a published endpoint, not an ECS API container secret.
API_URL=http://localhost:3000

# API server non-secret runtime config.
# In AWS, these are set as ECS task environment variables from Terraform.
HOST=0.0.0.0
PORT=3000
NODE_ENV=development
BEDROCK_AWS_REGION=ap-northeast-1
BEDROCK_CHAT_MODEL_ID=deepseek.v3.2

# API server database secret.
# In AWS, DATABASE_URL is generated in the Terraform-managed database secret.
DATABASE_URL=postgresql://nodcode:nodcode@localhost:5432/nodcode

# API server third-party secrets.
# In AWS, these live in the human/CI-managed api-runtime secret.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AWS_BEARER_TOKEN_BEDROCK=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID=
POLAR_SERVER=sandbox
POLAR_CREDITS_METER_ID=

# Local CLI OAuth config.
# These are consumed by packages/cli, not by the ECS API server.
CLERK_FRONTEND_API=
CLERK_OAUTH_CLIENT_ID=
