{
  "name": "@nodcode/server",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "test": "bun test",
    "test:httpapi": "bun run script/httpapi-exercise.ts --mode=coverage --fail-on-missing --fail-on-skip && bun run script/httpapi-exercise.ts --mode=auth --fail-on-missing --fail-on-skip && bun run script/httpapi-exercise.ts --mode=effect --fail-on-missing --fail-on-skip",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "build:container": "bun build src/container.ts --outdir dist --target bun",
    "postinstall": "DATABASE_URL=${DATABASE_URL:-postgresql://nodcode:nodcode@localhost:5432/nodcode} bun run --cwd ../database db:generate"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^4.0.111",
    "@ai-sdk/anthropic": "^3.0.68",
    "@ai-sdk/openai": "^3.0.52",
    "@aws-sdk/credential-providers": "^3.1056.0",
    "@clerk/backend": "^3.2.8",
    "@hono/zod-validator": "^0.7.6",
    "@nodcode/database": "workspace:*",
    "@nodcode/shared": "workspace:*",
    "@polar-sh/sdk": "^0.47.1",
    "ai": "^6.0.154",
    "dotenv": "^17.4.1",
    "hono": "^4.12.12",
    "zod": "^4.3.6"
  }
}
