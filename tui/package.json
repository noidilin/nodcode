{
  "name": "nodcode",
  "version": "1.0.0",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev:cli": "bun run --watch packages/cli/src/index.tsx",
    "dev:server": "bun run --hot packages/server/src/index.ts",
    "compose:up": "bun run db:up && bun run db:push && docker compose up --build -d api",
    "compose:down": "docker compose down",
    "compose:logs": "docker compose logs -f api postgres",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate:deploy": "bun run --cwd packages/database db:migrate:deploy",
    "db:migrate:resolve:init": "bun run --cwd packages/database db:migrate:resolve:init",
    "db:migrate:status": "bun run --cwd packages/database db:migrate:status",
    "db:push": "bun run --cwd packages/database db:push",
    "test:server": "bun run --filter @nodcode/server test",
    "test:cli": "bun run --filter @nodcode/cli test",
    "test:httpapi": "bun run --filter @nodcode/server test:httpapi",
    "build:server": "bun run --filter @nodcode/server build",
    "build:cli": "bun run --filter @nodcode/cli build",
    "docker:build:server": "docker build -f Dockerfile -t nodcode-api:local .",
    "docker:smoke:server": "packages/server/script/container-smoke.sh",
    "link:cli": "bun run build:cli && cd packages/cli && bun link"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
